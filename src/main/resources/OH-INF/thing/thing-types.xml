<?xml version="1.0" encoding="UTF-8"?>
<thing:thing-descriptions bindingId="mytoyota"
	xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xmlns:thing="https://openhab.org/schemas/thing-description/v1.0.0"
	xsi:schemaLocation="https://openhab.org/schemas/thing-description/v1.0.0
                            https://openhab.org/schemas/thing-description-1.0.0.xsd">

	<!-- Bridge: the MyToyota account -->
	<bridge-type id="account">
		<label>MyToyota Account</label>
		<description>Your MyToyota (Toyota, Lexus or Subaru Europe) app login. The vehicles of the account are found by
			discovery.</description>

		<config-description>
			<parameter name="username" type="text" required="true">
				<label>Username</label>
				<description>The e-mail address you log into the MyToyota app with.</description>
			</parameter>
			<parameter name="password" type="text" required="true">
				<label>Password</label>
				<context>password</context>
			</parameter>
			<parameter name="brand" type="text" required="false">
				<label>Brand</label>
				<description>T = Toyota, L = Lexus, S = Subaru.</description>
				<default>T</default>
				<options>
					<option value="T">Toyota</option>
					<option value="L">Lexus</option>
					<option value="S">Subaru</option>
				</options>
				<limitToOptions>true</limitToOptions>
			</parameter>
			<parameter name="pollInterval" type="integer" min="1" max="1440" unit="min" required="false">
				<label>Poll Interval</label>
				<description>Minutes between reads of every vehicle under this account. Reads only fetch what the cloud
					already holds; they do not wake the car.</description>
				<default>5</default>
			</parameter>
			<parameter name="wakeWhileCharging" type="integer" min="0" max="1440" unit="min" required="false">
				<label>Wake While Charging</label>
				<description>While the car reports that it is charging, ask it for a fresh state of charge before a
					poll, at most every this many minutes. The car's modem is woken by that request. 0 disables it.</description>
				<default>10</default>
			</parameter>
		</config-description>
	</bridge-type>

	<!-- Thing: one vehicle -->
	<thing-type id="vehicle">
		<supported-bridge-type-refs>
			<bridge-type-ref id="account"/>
		</supported-bridge-type-refs>

		<label>Toyota Vehicle</label>
		<description>A vehicle of the account: battery, range, charging, odometer, last parked position, doors, windows,
			lights and climate state.</description>

		<channel-groups>
			<channel-group id="battery" typeId="battery"/>
			<channel-group id="telemetry" typeId="telemetry"/>
			<channel-group id="trips" typeId="trips"/>
			<channel-group id="service" typeId="service"/>
			<channel-group id="location" typeId="location"/>
			<channel-group id="status" typeId="status"/>
			<channel-group id="doors" typeId="doors"/>
			<channel-group id="windows" typeId="windows"/>
			<channel-group id="lights" typeId="lights"/>
			<channel-group id="health" typeId="health"/>
			<channel-group id="climate" typeId="climate"/>
			<channel-group id="notifications" typeId="notifications"/>
			<channel-group id="control" typeId="control"/>
		</channel-groups>

		<properties>
			<property name="vendor">Toyota</property>
		</properties>
		<representation-property>vin</representation-property>

		<config-description>
			<parameter name="vin" type="text" required="true">
				<label>VIN</label>
				<description>Vehicle identification number, 17 characters. Filled in by discovery.</description>
			</parameter>
		</config-description>
	</thing-type>

	<!-- Channel groups -->
	<channel-group-type id="battery">
		<label>Battery</label>
		<channels>
			<channel id="level" typeId="battery-level"/>
			<channel id="range" typeId="range">
				<label>EV Range</label>
			</channel>
			<channel id="rangeWithAc" typeId="range">
				<label>EV Range with A/C</label>
			</channel>
			<channel id="chargingStatus" typeId="charging-status"/>
			<channel id="charging" typeId="charging"/>
			<channel id="remainingChargeTime" typeId="remaining-charge-time"/>
			<channel id="lastUpdate" typeId="timestamp">
				<label>Battery Reported</label>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="telemetry">
		<label>Telemetry</label>
		<channels>
			<channel id="odometer" typeId="odometer"/>
			<channel id="distanceToEmpty" typeId="range">
				<label>Distance to Empty</label>
			</channel>
			<channel id="fuelLevel" typeId="fuel-level"/>
			<channel id="lastUpdate" typeId="timestamp">
				<label>Telemetry Reported</label>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="trips">
		<label>Trips</label>
		<description>From the cloud's trip history: the newest trip, today's and this month's totals. A trip appears when
			the car parks; the binding reads the history then and once an hour.</description>
		<channels>
			<channel id="latestStart" typeId="timestamp"><label>Latest Trip Start</label></channel>
			<channel id="latestEnd" typeId="timestamp"><label>Latest Trip End</label></channel>
			<channel id="latestDistance" typeId="trip-distance"><label>Latest Trip Distance</label></channel>
			<channel id="latestDuration" typeId="trip-duration"><label>Latest Trip Duration</label></channel>
			<channel id="latestAverageSpeed" typeId="trip-speed"/>
			<channel id="latestFuel" typeId="trip-fuel"><label>Latest Trip Fuel</label></channel>
			<channel id="latestEvDistance" typeId="trip-distance"><label>Latest Trip EV Distance</label></channel>
			<channel id="latestScore" typeId="trip-score"/>
			<channel id="todayDistance" typeId="trip-distance"><label>Today Distance</label></channel>
			<channel id="monthDistance" typeId="trip-distance"><label>This Month Distance</label></channel>
			<channel id="monthDuration" typeId="trip-duration"><label>This Month Driving Time</label></channel>
			<channel id="monthFuel" typeId="trip-fuel"><label>This Month Fuel</label></channel>
			<channel id="count30Days" typeId="trip-count"/>
			<channel id="latestStartPosition" typeId="trip-position"><label>Latest Trip Start Position</label></channel>
			<channel id="latestEndPosition" typeId="trip-position"><label>Latest Trip End Position</label></channel>
			<channel id="latestRoute" typeId="trip-route"/>
			<channel id="latestId" typeId="trip-id"/>
			<channel id="lastUpdate" typeId="timestamp"><label>Trips Read</label></channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="service">
		<label>Service History</label>
		<channels>
			<channel id="count" typeId="service-count"/>
			<channel id="lastDate" typeId="timestamp"><label>Last Service Date</label></channel>
			<channel id="lastCategory" typeId="service-text"><label>Last Service</label></channel>
			<channel id="lastProvider" typeId="service-text"><label>Last Service Provider</label></channel>
			<channel id="lastMileage" typeId="odometer"><label>Odometer At Last Service</label></channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="location">
		<label>Location</label>
		<channels>
			<channel id="position" typeId="position"/>
			<channel id="name" typeId="location-name"/>
			<channel id="lastUpdate" typeId="timestamp">
				<label>Position Acquired</label>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="status">
		<label>Doors, Windows and Lights</label>
		<channels>
			<channel id="overall" typeId="overall-status"/>
			<channel id="warnings" typeId="warnings"/>
			<channel id="locked" typeId="locked"/>
			<channel id="anyDoorOpen" typeId="open-contact">
				<label>Any Door Open</label>
			</channel>
			<channel id="anyWindowOpen" typeId="open-contact">
				<label>Any Window Open</label>
			</channel>
			<channel id="trunkOpen" typeId="open-contact">
				<label>Trunk Open</label>
			</channel>
			<channel id="hoodOpen" typeId="open-contact">
				<label>Hood Open</label>
			</channel>
			<channel id="hazardLights" typeId="hazard-lights"/>
			<channel id="lastUpdate" typeId="timestamp">
				<label>Status Reported</label>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="doors">
		<label>Doors</label>
		<description>Per door, as the app's status page shows it.</description>
		<channels>
			<channel id="driverLocked" typeId="door-locked"><label>Driver Door Locked</label></channel>
			<channel id="driverOpen" typeId="open-contact"><label>Driver Door Open</label></channel>
			<channel id="passengerLocked" typeId="door-locked"><label>Passenger Door Locked</label></channel>
			<channel id="passengerOpen" typeId="open-contact"><label>Passenger Door Open</label></channel>
			<channel id="rearLeftLocked" typeId="door-locked"><label>Rear Left Door Locked</label></channel>
			<channel id="rearLeftOpen" typeId="open-contact"><label>Rear Left Door Open</label></channel>
			<channel id="rearRightLocked" typeId="door-locked"><label>Rear Right Door Locked</label></channel>
			<channel id="rearRightOpen" typeId="open-contact"><label>Rear Right Door Open</label></channel>
			<channel id="rearBackLocked" typeId="door-locked"><label>Trunk Locked</label></channel>
			<channel id="rearBackOpen" typeId="open-contact"><label>Trunk Open</label></channel>
			<channel id="hoodOpen" typeId="open-contact"><label>Hood Open</label></channel>
			<channel id="rearSeatReminder" typeId="rear-seat-reminder"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="windows">
		<label>Windows</label>
		<channels>
			<channel id="driver" typeId="window-state"><label>Driver Window</label></channel>
			<channel id="passenger" typeId="window-state"><label>Passenger Window</label></channel>
			<channel id="rearLeft" typeId="window-state"><label>Rear Left Window</label></channel>
			<channel id="rearRight" typeId="window-state"><label>Rear Right Window</label></channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="lights">
		<label>Lights</label>
		<channels>
			<channel id="hazard" typeId="light-state"><label>Hazard Lights</label></channel>
			<channel id="tail" typeId="light-state"><label>Tail Lights</label></channel>
			<channel id="head" typeId="light-state"><label>Headlights</label></channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="health">
		<label>Health</label>
		<description>The warnings behind the warning count, in words, from the vehicle health service.</description>
		<channels>
			<channel id="warnings" typeId="health-warnings"/>
			<channel id="warningCodes" typeId="health-codes"/>
			<channel id="severity" typeId="health-severity"/>
			<channel id="lastUpdate" typeId="timestamp"><label>Health Reported</label></channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="climate">
		<label>Climate</label>
		<channels>
			<channel id="status" typeId="climate-status"/>
			<channel id="startedAt" typeId="climate-started"/>
			<channel id="remaining" typeId="climate-remaining"/>
			<channel id="cabinTemperature" typeId="climate-cabin-temperature"/>
			<channel id="targetTemperature" typeId="climate-target-temperature"/>
		</channels>
	</channel-group-type>

	<channel-group-type id="notifications">
		<label>Notifications</label>
		<description>The messages the MyToyota app shows: "Your car is unlocked", "a keyfob was detected", "Climate Start
			requires at least 31% battery", command confirmations. Read on every poll from the cloud's notification
			history.</description>
		<channels>
			<channel id="latest" typeId="notification-text">
				<label>Latest Message</label>
			</channel>
			<channel id="latestTime" typeId="timestamp">
				<label>Latest Message Time</label>
			</channel>
			<channel id="latestCategory" typeId="notification-category"/>
			<channel id="unread" typeId="notification-unread"/>
			<channel id="recent" typeId="notification-text">
				<label>Recent Messages</label>
				<description>The five newest, one per line, each with its date and time.</description>
			</channel>
		</channels>
	</channel-group-type>

	<channel-group-type id="control">
		<label>Control</label>
		<description>Remote commands as the MyToyota app sends them. The cloud answers with a return code (000000 =
			accepted) shown on lastCommandResult; the car's own state channels are polled again 45 s later to confirm.
			Besides the channels listed here, the binding adds the ones this car reports it can do: trunk lock, buzzer,
			engine start/stop, headlights, windows open/close, ventilation, and the climate options (defrost, seat and
			steering wheel heaters).</description>
		<channels>
			<channel id="refresh" typeId="refresh"/>
			<channel id="lock" typeId="lock"/>
			<channel id="hazardLights" typeId="hazard-command"/>
			<channel id="horn" typeId="trigger-command">
				<label>Sound Horn</label>
			</channel>
			<channel id="findVehicle" typeId="trigger-command">
				<label>Find Vehicle</label>
				<description>Flashes the lights (and beeps on some models).</description>
			</channel>
			<channel id="climate" typeId="climate-command"/>
			<channel id="climateTemperature" typeId="climate-temperature"/>
			<channel id="climateDuration" typeId="climate-duration"/>
			<channel id="chargeNow" typeId="trigger-command">
				<label>Charge Now</label>
				<description>Start charging immediately, overriding a charging schedule, while plugged in.</description>
			</channel>
			<channel id="lastCommandResult" typeId="command-result"/>
			<channel id="lastWake" typeId="timestamp">
				<label>Last Wake Request</label>
			</channel>
			<channel id="lastPoll" typeId="timestamp">
				<label>Last Poll</label>
			</channel>
		</channels>
	</channel-group-type>

	<!-- Channel types -->
	<channel-type id="battery-level">
		<item-type>Number:Dimensionless</item-type>
		<label>Battery Level</label>
		<description>State of charge as the car last reported it.</description>
		<category>BatteryLevel</category>
		<tags>
			<tag>Measurement</tag>
			<tag>Energy</tag>
		</tags>
		<state readOnly="true" pattern="%.0f %%"/>
	</channel-type>

	<channel-type id="range">
		<item-type>Number:Length</item-type>
		<label>Range</label>
		<state readOnly="true" pattern="%.0f %unit%"/>
	</channel-type>

	<channel-type id="charging-status">
		<item-type>String</item-type>
		<label>Charging Status</label>
		<description>As reported by the car, for example none, charging, chargeComplete.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="charging">
		<item-type>Switch</item-type>
		<label>Charging</label>
		<description>ON while the charging status says charging.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="remaining-charge-time">
		<item-type>Number:Time</item-type>
		<label>Remaining Charge Time</label>
		<state readOnly="true" pattern="%.0f min"/>
	</channel-type>

	<channel-type id="odometer">
		<item-type>Number:Length</item-type>
		<label>Odometer</label>
		<state readOnly="true" pattern="%.0f %unit%"/>
	</channel-type>

	<channel-type id="position">
		<item-type>Location</item-type>
		<label>Last Parked Position</label>
		<description>Only updated when the car is parked.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="location-name" advanced="true">
		<item-type>String</item-type>
		<label>Position Name</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="overall-status" advanced="true">
		<item-type>String</item-type>
		<label>Overall Status</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="warnings" advanced="true">
		<item-type>Number</item-type>
		<label>Status Marks In Red</label>
		<description>How many items on the app's status page are red: unlocked or open doors, open windows. Verified on
			a bZ4X: five unlocked doors = 5. Not the health warnings (tyre pressure etc.), see the health group.</description>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="locked">
		<item-type>Switch</item-type>
		<label>Locked</label>
		<description>ON when every door reports locked.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="open-contact">
		<item-type>Contact</item-type>
		<label>Open</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="hazard-lights" advanced="true">
		<item-type>Switch</item-type>
		<label>Hazard Lights</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="climate-status">
		<item-type>String</item-type>
		<label>Climate Status</label>
		<description>stopped, starting or running.</description>
		<state readOnly="true"/>
	</channel-type>

	<!--
		The climate-status payload collapses to just the status while the climate is off, and
		fills in the rest only while it is starting or running. There is no countdown in it;
		the time left is startedAt + duration - now.
	-->
	<channel-type id="climate-started">
		<item-type>DateTime</item-type>
		<label>Climate Started</label>
		<description>When the running climate session began. UNDEF while stopped.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="climate-remaining">
		<item-type>Number:Time</item-type>
		<label>Climate Remaining</label>
		<description>Minutes left of the running climate session. UNDEF while stopped.</description>
		<state readOnly="true" pattern="%.0f min"/>
	</channel-type>

	<channel-type id="climate-cabin-temperature">
		<item-type>Number:Temperature</item-type>
		<label>Cabin Temperature</label>
		<description>Measured cabin temperature, reported while the climate runs.</description>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="climate-target-temperature">
		<item-type>Number:Temperature</item-type>
		<label>Climate Target Temperature</label>
		<description>What the running session is aiming for.</description>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="refresh">
		<item-type>Switch</item-type>
		<label>Refresh From Car</label>
		<description>Send ON to wake the car for a fresh state of charge and door/window state; the vehicle is polled
			again 45 seconds later. Each request wakes the car's modem, so do not automate it every minute.</description>
	</channel-type>

	<channel-type id="lock">
		<item-type>Switch</item-type>
		<label>Lock</label>
		<description>ON locks the doors, OFF unlocks them. Read back on status#locked after the confirming poll.</description>
		<autoUpdatePolicy>veto</autoUpdatePolicy>
	</channel-type>

	<channel-type id="hazard-command">
		<item-type>Switch</item-type>
		<label>Hazard Lights</label>
		<description>ON switches the hazard lights on, OFF off.</description>
		<autoUpdatePolicy>veto</autoUpdatePolicy>
	</channel-type>

	<channel-type id="trigger-command">
		<item-type>Switch</item-type>
		<label>Command</label>
		<description>Send ON to run the command once; the channel returns to OFF.</description>
		<autoUpdatePolicy>veto</autoUpdatePolicy>
	</channel-type>

	<channel-type id="climate-command">
		<item-type>Switch</item-type>
		<label>Climate</label>
		<description>ON starts the remote climate with climateTemperature for climateDuration minutes, OFF stops it.
			Confirmation on climate#status.</description>
		<autoUpdatePolicy>veto</autoUpdatePolicy>
	</channel-type>

	<channel-type id="climate-temperature">
		<item-type>Number:Temperature</item-type>
		<label>Climate Temperature</label>
		<description>Target temperature for the next climate start. Seeded from the car's saved setting.</description>
		<state min="16" max="30" step="0.5" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="climate-duration">
		<item-type>Number:Time</item-type>
		<label>Climate Duration</label>
		<description>Minutes the remote climate runs. Seeded from the car's saved setting.</description>
		<state min="5" max="60" step="5" pattern="%.0f min"/>
	</channel-type>

	<channel-type id="command-result">
		<item-type>String</item-type>
		<label>Last Command Result</label>
		<description>The last command and the cloud's return code, e.g. "door-lock: 000000 (Success)".</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="notification-text">
		<item-type>String</item-type>
		<label>Notification</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="notification-category" advanced="true">
		<item-type>String</item-type>
		<label>Latest Message Category</label>
		<description>RemoteControl, VehicleStatusAlert, ...</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="notification-unread">
		<item-type>Number</item-type>
		<label>Unread Messages</label>
		<description>Messages not yet opened in the app. The binding cannot mark them read.</description>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="door-locked">
		<item-type>Switch</item-type>
		<label>Locked</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="window-state">
		<item-type>String</item-type>
		<label>Window</label>
		<description>close, open or unknown (some cars do not report the rear windows).</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="light-state">
		<item-type>Switch</item-type>
		<label>Light</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="rear-seat-reminder" advanced="true">
		<item-type>String</item-type>
		<label>Rear Seat Reminder</label>
		<description>ok, notDetected, or warning: something may have been left on the rear seat.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="health-warnings">
		<item-type>String</item-type>
		<label>Active Warnings</label>
		<description>Each active warning with its severity and start time, or "none". Example: "Tire Pressure Warning
			System (severity 4) since 21/09 16:45".</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="health-codes" advanced="true">
		<item-type>String</item-type>
		<label>Warning Codes</label>
		<description>Toyota's codes, e.g. TIRW, comma separated.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="health-severity">
		<item-type>Number</item-type>
		<label>Worst Severity</label>
		<description>The highest severity among active warnings; 0 when none.</description>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="trunk-lock">
		<item-type>Switch</item-type>
		<label>Trunk Lock</label>
		<description>ON locks the trunk, OFF unlocks it. Created only for cars that report trunkLockUnlockCapable.</description>
		<autoUpdatePolicy>veto</autoUpdatePolicy>
	</channel-type>

	<channel-type id="engine">
		<item-type>Switch</item-type>
		<label>Engine</label>
		<description>ON starts the engine remotely, OFF stops it (hybrids and combustion cars that report
			remoteEngineStartStop; never created for a battery EV).</description>
		<autoUpdatePolicy>veto</autoUpdatePolicy>
	</channel-type>

	<channel-type id="headlights">
		<item-type>Switch</item-type>
		<label>Headlights</label>
		<description>ON / OFF, for cars that report lightsCapable.</description>
		<autoUpdatePolicy>veto</autoUpdatePolicy>
	</channel-type>

	<channel-type id="climate-option">
		<item-type>Switch</item-type>
		<label>Climate Option</label>
		<description>An on/off option sent with the next remote climate start and saved in the car (the app's
			"climate schedule"): front defrost, rear defogger, steering wheel heater, mirror heater, seat heaters.
			Created only for the options the car reports.</description>
	</channel-type>

	<channel-type id="fuel-level">
		<item-type>Number:Dimensionless</item-type>
		<label>Fuel Level</label>
		<description>Hybrids and combustion cars; UNDEF on a battery EV.</description>
		<state readOnly="true" pattern="%.0f %%"/>
	</channel-type>

	<channel-type id="trip-distance">
		<item-type>Number:Length</item-type>
		<label>Distance</label>
		<state readOnly="true" pattern="%.1f %unit%"/>
	</channel-type>

	<channel-type id="trip-duration">
		<item-type>Number:Time</item-type>
		<label>Duration</label>
		<state readOnly="true" pattern="%.0f min"/>
	</channel-type>

	<channel-type id="trip-speed">
		<item-type>Number:Speed</item-type>
		<label>Latest Trip Average Speed</label>
		<state readOnly="true" pattern="%.0f %unit%"/>
	</channel-type>

	<channel-type id="trip-fuel">
		<item-type>Number:Volume</item-type>
		<label>Fuel</label>
		<description>Fuel used, litres; UNDEF on a battery EV.</description>
		<state readOnly="true" pattern="%.2f %unit%"/>
	</channel-type>

	<channel-type id="trip-score">
		<item-type>Number</item-type>
		<label>Latest Trip Score</label>
		<description>Toyota's driving score for the trip, 0 to 100.</description>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="trip-count">
		<item-type>Number</item-type>
		<label>Trips In 30 Days</label>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="service-count">
		<item-type>Number</item-type>
		<label>Service Records</label>
		<state readOnly="true" pattern="%d"/>
	</channel-type>

	<channel-type id="service-text" advanced="true">
		<item-type>String</item-type>
		<label>Service</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="trip-position">
		<item-type>Location</item-type>
		<label>Trip Position</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="trip-route" advanced="true">
		<item-type>String</item-type>
		<label>Latest Trip Route</label>
		<description>The route as "lat,lon,flags;…" (five decimals; flags e = electric, h = highway, o = over the
			limit). For a map; a few hundred points per trip. Do not persist it.</description>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="trip-id" advanced="true">
		<item-type>String</item-type>
		<label>Latest Trip Id</label>
		<state readOnly="true"/>
	</channel-type>

	<channel-type id="timestamp" advanced="true">
		<item-type>DateTime</item-type>
		<label>Timestamp</label>
		<state readOnly="true"/>
	</channel-type>

</thing:thing-descriptions>
